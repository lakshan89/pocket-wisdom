# Copy to .env for local development. Deployed environments get these
# values from SSM Parameter Store, never from a file in the image.
NODE_ENV=development
APP_ENV=local
PORT=3000
LOG_LEVEL=debug
DOCS_ENABLED=true
RATE_LIMIT_PER_MINUTE=100
APP_VERSION=local
# Matches the local Postgres in docker-compose.
DATABASE_URL=postgres://pocket:pocket@localhost:5432/pocket_wisdom
# Host port for the compose database. Change it, and the port above, only if
# something else already listens on 5432.
# POSTGRES_PORT=5432
DATABASE_POOL_MAX=10
# HS256 signing key for access tokens. Generate with: openssl rand -base64 32
# Never reuse a key between environments.
JWT_SECRET=change-me-change-me-change-me-change-me
